// Builds ../../registry.json, the index the `senn` CLI reads to install templates.
// Run after adding or changing a template: `pnpm registry`.

import { readFileSync, readdirSync, statSync, writeFileSync } from "node:fs";
import { join, relative } from "node:path";
import { fileURLToPath } from "node:url";
import { agentSkill } from "../src/senn/agent-prompt.ts";
import { catalog } from "../src/templates/catalog.ts";

const here = fileURLToPath(new URL(".", import.meta.url));
const site = join(here, "..");
const repoRoot = join(site, "..");

// Install the same version ranges the site is built and tested with.
const pkg = JSON.parse(readFileSync(join(site, "package.json"), "utf8"));
const versions: Record<string, string> = { ...pkg.dependencies, ...pkg.devDependencies };
const pin = (name: string) => (versions[name] ? `${name}@${versions[name]}` : name);

// Template files that stay in this repository instead of being installed.
const SKIP = new Set(["README.md", ".DS_Store"]);

function listFiles(dir: string): string[] {
  return readdirSync(dir).flatMap((name) => {
    if (SKIP.has(name)) return [];
    const path = join(dir, name);
    return statSync(path).isDirectory() ? listFiles(path) : [path];
  });
}

// Packages a template really imports (any quote style), so the registry can't drift
// from the code. next and react are already in every Next.js project.
const PROVIDED = new Set(["next", "react", "react-dom"]);
function importedPackages(files: string[]) {
  const found = new Set<string>();
  for (const file of files.filter((f) => /\.(tsx?|mts|jsx?)$/.test(f))) {
    for (const [, spec] of readFileSync(file, "utf8").matchAll(/from\s+['"]([^'"]+)['"]/g)) {
      if (spec.startsWith(".") || spec.startsWith("@/")) continue;
      const name = spec.startsWith("@") ? spec.split("/").slice(0, 2).join("/") : spec.split("/")[0];
      if (!PROVIDED.has(name)) found.add(name);
    }
  }
  return [...found].sort();
}

const templates = catalog.map((t) => {
  if (t.status !== "live") {
    return { slug: t.slug, name: t.name, status: t.status, description: t.description };
  }
  const dir = join(site, "src/templates", t.slug);
  const paths = listFiles(dir);
  const imported = importedPackages(paths);
  const listed = [...(t.dependencies ?? [])].sort();
  if (imported.join() !== listed.join()) {
    throw new Error(
      `${t.slug}: catalog.ts dependencies [${listed}] don't match the template's imports [${imported}]. Update catalog.ts.`,
    );
  }
  return {
    slug: t.slug,
    name: t.name,
    status: t.status,
    description: t.description,
    // Paths relative to the repository root, then relative to the template folder.
    source: relative(repoRoot, dir),
    files: paths.map((f) => relative(dir, f)).sort(),
    dependencies: (t.dependencies ?? []).map(pin),
    skill: agentSkill(t),
  };
});

const registry = {
  $comment: "Generated by site/scripts/build-registry.ts. Do not edit by hand.",
  repo: "rusilkoirala/senn",
  branch: "main",
  // Shared helpers templates import; installed only when the project lacks them.
  shared: [
    {
      path: "lib/utils.ts",
      content: 'export { cn } from "cn";\n',
      dependencies: [pin("cn")],
    },
  ],
  templates,
};

writeFileSync(join(repoRoot, "registry.json"), JSON.stringify(registry, null, 2) + "\n");
console.log(`registry.json: ${templates.filter((t) => t.status === "live").length} live, ${templates.length} total`);
